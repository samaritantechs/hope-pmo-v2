# Copy this file to .env (migration scripts) and also set these same two values in
# Vercel: Project Settings -> Environment Variables (for the API routes).
#
# Get both from: Supabase Dashboard -> Project Settings -> API

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ^ Service role key, NOT the anon/public key. The service role key bypasses Row Level
# Security so the API layer can enforce YOUR access-code permission logic instead
# (see api/lib/auth.js) -- same trust model as Code.gs today. Never expose this key to
# the browser/frontend; it only ever lives in Vercel's server-side environment and in
# your own local .env for running migrations, never in client-side code.
