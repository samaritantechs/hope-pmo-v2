<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- GPS for the loan KYC capture screens (residence/business/guarantor location). Both are
         needed: FINE for an actual reading, COARSE because some OEM WebViews refuse the
         geolocation prompt if only FINE is declared. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Officers with no lock-app installed are followed the same way a locked handset is
         (OfficerLocationService), but only while it can run as a FOREGROUND service, which on
         Android 10+ is the only way a plain LocationManager keeps delivering fixes once the app
         is off screen. Foreground-only permission (above) still works whenever the app is open;
         this is what lets it keep working the rest of the time, requested only once it is about
         to actually be used: see MainActivity.startOrStopLocationService_. (No double hyphen
         anywhere in this comment on purpose: XML forbids it, and the manifest merger fails the
         whole build on one.) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Android 13+ refuses to show ANY notification, including a foreground service's own,
         without this; bundled into the app's one combined permission ask alongside call log,
         location and camera, see requestMissingPermissions. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The imprest-alert job (AlertJobService) is persisted so it survives a reboot; Android
         requires this permission for a persisted job. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The KYC photo/signature/thumbprint capture screens (openCameraOverlay_ in app.html) call
         getUserMedia() for a live camera feed, never a gallery picker. Without this declared, a
         WebView's PermissionRequest for it is refused with no OS prompt at all; see
         onPermissionRequest below. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Lets the app offer its own update; Android still shows the normal install prompt. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.HopeCalls">
        <!-- singleTop: a tap on an imprest alert while the app is open reaches onNewIntent and
             opens the request in the page already on screen, instead of stacking a second copy
             of the whole app. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Started/stopped by an officer's own sign-in/out (HopeCallsBridge.setOfficerCode ->
             MainActivity.startOrStopLocationService_), never on its own. See
             OfficerLocationService's own header comment for what it does and why. -->
        <service
            android:name=".OfficerLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- The background half of the imprest alerts: a periodic JobScheduler job that asks the
             portal for this code's queued alerts about every fifteen minutes. See AlertPoller
             and AlertJobService. -->
        <service
            android:name=".AlertJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The downloaded APK is handed to the installer as a content:// URI; a file:// one
             throws FileUriExposedException on Android 7+. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
